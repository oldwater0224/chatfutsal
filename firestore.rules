rules_version = '2';

// 명시적으로 허용하지 않은 경로는 모두 거부한다
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // 배열 필드에서 이번 쓰기로 추가/제거된 값
    function addedTo(field) {
      return request.resource.data.get(field, []).toSet()
        .difference(resource.data.get(field, []).toSet());
    }

    function removedFrom(field) {
      return resource.data.get(field, []).toSet()
        .difference(request.resource.data.get(field, []).toSet());
    }

    // ===== 닉네임 =====
    // 클라이언트 검사(src/lib/services/userRules.ts)와 같은 규칙. size()는 UTF-16 코드 단위라
    // 클라이언트의 12자(코드 포인트)는 최대 24단위가 된다. ZWJ(이모지 조합)는 허용한다.
    // 금지 문자: C0 제어문자·DEL, 보이지 않는 문자(U+200B, U+2060, U+FEFF), 방향 제어(U+202A-202E, U+2066-2069)
    function validName(v) {
      return v is string
        && v.size() >= 2
        && v.size() <= 24
        && v.trim() == v
        && !v.matches('(?s).*[\\x{0}-\\x{1F}\\x{7F}\\x{200B}\\x{2060}\\x{FEFF}\\x{202A}-\\x{202E}\\x{2066}-\\x{2069}].*');
    }

    // 다른 문서에 복사하는 이름(authorName, applicantName, participantNames)은
    // 그 사용자의 users 문서 닉네임과 같거나 기본값 '사용자'여야 한다.
    // 형식 검사는 하지 않는다 (예전에 저장된 긴 닉네임도 그대로 복사할 수 있게)
    function copiedNameOf(v, uid) {
      return v is string
        && (v == '사용자'
          || (exists(/databases/$(database)/documents/users/$(uid))
            && get(/databases/$(database)/documents/users/$(uid)).data.get('displayName', null) == v));
    }

    // ===== users =====
    match /users/{userId} {
      // 닉네임을 건드릴 때만 검사한다. 예전 규칙으로 저장된 닉네임이 있어도 다른 필드는 바꿀 수 있고,
      // 닉네임 삭제는 validName(null)이 거짓이라 막힌다.
      function nameUnchangedOrValid() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'])
          || validName(request.resource.data.get('displayName', null));
      }

      allow read: if signedIn();
      allow create: if isUser(userId)
        && validName(request.resource.data.get('displayName', null));
      allow update: if isUser(userId) && nameUnchangedOrValid();
    }

    // ===== recruitPosts =====
    match /recruitPosts/{postId} {
      // 경기 시작 시각(date "YYYY-MM-DD" + time "HH:MM", KST)이 지났는지
      function matchStarted(post) {
        let d = post.date.split('-');
        let t = post.time.split(':');
        return request.time >= timestamp.date(int(d[0]), int(d[1]), int(d[2]))
          + duration.value(int(t[0]) * 60 + int(t[1]) - 9 * 60, 'm');
      }

      allow read: if signedIn();

      allow create: if isUser(request.resource.data.authorId)
        && request.resource.data.status == 'open'
        && copiedNameOf(request.resource.data.get('authorName', null), request.auth.uid);

      allow update: if
        // 작성자: 자유롭게 수정 (작성자 변경은 불가, 작성자 이름은 바꿀 때만 현재 닉네임으로)
        (isUser(resource.data.authorId)
          && request.resource.data.authorId == resource.data.authorId
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorName'])
            || copiedNameOf(request.resource.data.get('authorName', null), request.auth.uid)))
        // 신청자: 모집 중인 글의 applicantIds에 자기 uid만 추가
        || (signedIn()
          && resource.data.status == 'open'
          && changedOnly(['applicantIds'])
          && addedTo('applicantIds') == [request.auth.uid].toSet()
          && removedFrom('applicantIds').size() == 0)
        // 신청자: applicantIds에서 자기 uid만 제거 (신청 취소)
        || (signedIn()
          && changedOnly(['applicantIds'])
          && addedTo('applicantIds').size() == 0
          && removedFrom('applicantIds').hasOnly([request.auth.uid]))
        // 누구나: 경기 시간이 지난 글을 마감 처리
        || (signedIn()
          && resource.data.status == 'open'
          && request.resource.data.status == 'closed'
          && changedOnly(['status', 'updatedAt'])
          && matchStarted(resource.data));

      allow delete: if isUser(resource.data.authorId);
    }

    // ===== applications =====
    match /applications/{applicationId} {
      function postOf(postId) {
        return get(/databases/$(database)/documents/recruitPosts/$(postId)).data;
      }

      // 모집글 상세에서 신청 목록을 postId로 조회하므로 로그인 사용자 전체에 허용
      allow read: if signedIn();

      allow create: if isUser(request.resource.data.applicantId)
        && request.resource.data.keys().hasOnly([
          'postId', 'postTitle', 'applicantId', 'applicantName',
          'authorId', 'message', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.status == 'pending'
        && copiedNameOf(request.resource.data.get('applicantName', null), request.auth.uid)
        && postOf(request.resource.data.postId).status == 'open'
        && request.resource.data.authorId == postOf(request.resource.data.postId).authorId
        && request.resource.data.authorId != request.auth.uid
        // 중복 신청 방지: 기존 신청자가 아니어야 하고, 같은 쓰기에서 applicantIds에 추가되어야 한다
        && !(request.auth.uid in postOf(request.resource.data.postId).get('applicantIds', []))
        && request.auth.uid in getAfter(
          /databases/$(database)/documents/recruitPosts/$(request.resource.data.postId)
        ).data.get('applicantIds', []);

      // 모집글 작성자: 대기 중인 신청을 수락/거절/모집 마감 처리
      allow update: if isUser(resource.data.authorId)
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected', 'closed']
        && changedOnly(['status', 'updatedAt']);

      // 신청자: 대기 중인 신청만 취소
      // 작성자: 모집글을 삭제하면서(또는 삭제된 뒤) 자기 글의 신청 정리
      allow delete: if (isUser(resource.data.applicantId)
          && resource.data.status == 'pending')
        || (isUser(resource.data.authorId)
          && !existsAfter(/databases/$(database)/documents/recruitPosts/$(resource.data.postId)));
    }

    // ===== fcmTokens =====
    // 웹 푸시 토큰 (문서 ID = 토큰, 기기당 하나). 소유자(uid)만 읽고 지운다.
    // 같은 기기에서 다른 계정으로 로그인하면 그 계정이 덮어써 소유자가 바뀐다.
    match /fcmTokens/{token} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'updatedAt']);
    }

    // ===== notifications =====
    match /notifications/{notificationId} {
      allow read, delete: if isUser(resource.data.recipientId);

      // 알림은 다른 사용자에게 보내는 용도로만 생성
      allow create: if signedIn()
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.isRead == false
        && request.resource.data.keys().hasOnly([
          'recipientId', 'senderId', 'type', 'title', 'body', 'link', 'isRead', 'createdAt'])
        // 보낸 사람은 작성자 본인만 (푸시 발송이 호출자와 대조한다). 이전 버전 클라이언트는 없이 보낸다
        && request.resource.data.get('senderId', request.auth.uid) == request.auth.uid
        // 푸시는 방금 만든 알림만 보내므로 생성 시각을 클라이언트가 정하지 못하게 한다
        && request.resource.data.createdAt == request.time;

      allow update: if isUser(resource.data.recipientId)
        && changedOnly(['isRead']);
    }

    // ===== chatRooms =====
    match /chatRooms/{roomId} {
      function isParticipant() {
        return signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;
      }

      allow read, delete: if signedIn() && request.auth.uid in resource.data.participants;

      // 새 방의 participantNames: 참여자 항목만, 각 값은 그 사람의 users 문서 닉네임 또는 '사용자'
      // (항목이 없으면 화면이 '사용자'로 표시하므로 허용)
      function participantNamesValid(data) {
        let names = data.get('participantNames', {});
        let p = data.participants;
        return names is map
          && names.keys().hasOnly(p)
          && copiedNameOf(names.get(p[0], '사용자'), p[0])
          && copiedNameOf(names.get(p[1], '사용자'), p[1]);
      }

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && participantNamesValid(request.resource.data);

      // 닉네임 변경 반영: participantNames에서 내 항목만, 내 users 문서의 현재 닉네임으로
      function changesOnlyOwnName() {
        return changedOnly(['participantNames'])
          && request.resource.data.participantNames.diff(resource.data.participantNames)
               .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.participantNames[request.auth.uid]
               == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName;
      }

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && (changedOnly(['lastMessage', 'lastMessageAt', 'leftAt']) || changesOnlyOwnName());

      match /messages/{messageId} {
        allow read, delete: if isParticipant();

        allow create: if isParticipant()
          && request.resource.data.senderId == request.auth.uid;

        // 읽음 처리: readBy에 자기 uid만 추가
        allow update: if isParticipant()
          && changedOnly(['readBy'])
          && addedTo('readBy') == [request.auth.uid].toSet()
          && removedFrom('readBy').size() == 0;
      }
    }
  }
}
